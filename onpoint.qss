/*
    On Point Photo Editor
    Graphite + Dark Brown Amber v4 theme

    Main neutral surfaces stay color-neutral so the interface does not
    influence photo correction decisions. Muted dark-brown amber appears mainly on
    hover, focus, selection, and active controls.
*/

/* ---------- Core shell ---------- */
QWidget {
    color: #D9DEE1;
    font-family: "Noto Sans", "Segoe UI", sans-serif;
    font-size: 10pt;
}

QMainWindow,
QWidget#centralwidget {
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 0,
        stop: 0 #151719,
        stop: 0.42 #202326,
        stop: 1 #303438
    );
}

QDialog,
QMessageBox {
    background-color: #24282B;
}

/* ---------- Menu bar and menus ---------- */
QMenuBar {
    background-color: #191C1E;
    color: #C9CED1;
    border-bottom: 1px solid #3D4347;
    padding: 2px 5px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 8px;
    border-radius: 3px;
}

QMenuBar::item:selected {
    background-color: #30363A;
    color: #F1F4F5;
}

QMenu {
    background-color: #24282B;
    color: #D9DEE1;
    border: 1px solid #4A5156;
    padding: 5px;
}

QMenu::item {
    padding: 6px 28px 6px 10px;
    border-radius: 3px;
}

QMenu::item:selected {
    background-color: #302821;
    color: #F4F7F8;
}

QMenu::separator {
    height: 1px;
    background-color: #42484C;
    margin: 5px 7px;
}

/* ---------- Main toolbar ---------- */
QToolBar#mainToolBar {
    background-color: #202326;
    border: none;
    border-bottom: 1px solid #444A4E;
    spacing: 3px;
    padding: 4px 6px;
}

QToolBar::separator {
    background-color: #454B4F;
    width: 1px;
    margin: 5px 6px;
}

QToolButton {
    background-color: transparent;
    color: #C5CACD;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 5px 7px;
}

QToolButton:hover {
    background-color: #30363A;
    border-color: #505A5F;
    color: #F0F3F4;
}

QToolButton:pressed,
QToolButton:checked {
    background-color: #352B23;
    border-color: #76573A;
    color: #F4F7F8;
}

QToolButton:disabled {
    color: #666D71;
    background: transparent;
}

QWidget#openFileToolbarWidget {
    background-color: #191C1E;
    border: 1px solid #76573A;
    border-radius: 5px;
}

QLabel#openFileNameLabel {
    background: transparent;
    color: #D9DEE1;
    border: none;
    padding: 0 3px;
    font-weight: 500;
}

QToolButton#closeFileToolbarButton {
    background: transparent;
    color: #AEB4B7;
    border: none;
    border-left: 1px solid #51483F;
    border-radius: 0 4px 4px 0;
    padding: 0;
    font-size: 14pt;
    font-weight: 500;
}

QToolButton#closeFileToolbarButton:hover {
    background-color: #352B23;
    color: #F4F7F8;
    border-left-color: #76573A;
}

QToolButton#closeFileToolbarButton:pressed {
    background-color: #2A211B;
    color: #FFFFFF;
}

/* ---------- Photo workspace ---------- */
QScrollArea#previewScrollArea {
    background-color: #000000;
    border: 1px solid #303538;
    border-radius: 3px;
}

QScrollArea#previewScrollArea > QWidget > QWidget,
QWidget#previewScrollAreaContents {
    background-color: #000000;
}

QLabel#imagePreviewLabel {
    background-color: #000000;
    color: #969B9E;
    border: 1px solid #24282A;
    font-size: 18px;
}

QWidget#showOriginalBar {
    background-color: #191C1E;
    border-top: 1px solid #3D4347;
    border-left: 1px solid #343A3E;
    border-right: 1px solid #343A3E;
    border-bottom: 1px solid #343A3E;
    border-radius: 3px;
}

QPushButton#showOriginalButton {
    min-width: 200px;
    max-width: 200px;
    min-height: 18px;
    max-height: 18px;
    padding: 1px 8px;
    background-color: #2C3135;
    color: #C7CDD1;
    border: 1px solid #43484C;
    border-radius: 4px;
    font-size: 9pt;
    font-weight: 500;
}

QPushButton#showOriginalButton:hover {
    background-color: #34393D;
    border: 1px solid #5A6065;
    color: #E1E5E8;
}

QPushButton#showOriginalButton:pressed {
    background-color: #3C2F24;
    border: 1px solid #6A4C35;
    color: #F0E5D6;
}

QPushButton#showOriginalButton:disabled {
    background-color: #292C2F;
    border-color: #393E42;
    color: #6F767A;
}


/* Overexposure Recovery main-workspace action row. */
QWidget#overexposureBottomActions {
    background: transparent;
}

QPushButton#overexposureCancelButton,
QPushButton#overexposureApplyButton,
QPushButton#overexposureFinishButton {
    min-height: 18px;
    max-height: 18px;
    min-width: 84px;
    padding: 1px 9px;
    font-size: 9pt;
}

QPushButton#overexposureFinishButton {
    background-color: #3B443A;
    border-color: #596B55;
    color: #E3EBE1;
}

QPushButton#overexposureFinishButton:hover {
    background-color: #465345;
    border-color: #71856C;
}

QPushButton#overexposureCancelButton {
    background-color: #3A3030;
    border-color: #644A4A;
}

QPushButton#overexposureCancelButton:hover {
    background-color: #493737;
    border-color: #805B5B;
}

/* ---------- Tools dock ---------- */
QDockWidget#toolsDock {
    background-color: #1B1E20;
    color: #D9DEE1;
    border-left: 1px solid #3B4145;
}

QWidget#toolsDockContents,
QScrollArea#toolsScrollArea,
QWidget#toolsScrollContents {
    background-color: #1A1C1E;
    border: none;
}


/* ---------- Overexposure Recovery workspace ---------- */
QWidget#overexposureWorkspace,
QWidget#overexposureControlsContent,
QScrollArea#overexposureControlsScroll,
QScrollArea#overexposureControlsScroll > QWidget > QWidget {
    background-color: #1A1C1E;
    border: none;
}

QLabel#overexposureWorkspaceTitle {
    color: #F0F3F4;
    font-size: 11pt;
    font-weight: 700;
}

QLabel#overexposureWorkspaceInstruction,
QLabel#overexposureTabInstruction {
    color: #AEB5B9;
    font-size: 9pt;
}

QPushButton#overexposureResetButton {
    min-height: 18px;
    max-height: 18px;
    padding: 1px 8px;
    font-size: 9pt;
}

QPushButton#overexposureModeButton,
QPushButton#overexposureAreaModeButton,
QPushButton#overexposureEyedropperButton {
    min-height: 20px;
    padding: 2px 7px;
    font-size: 9pt;
}

QPushButton#overexposureAreaModeButton:checked {
    background-color: #4A3526;
    border-color: #98704A;
    color: #FFFFFF;
}

QWidget#overexposureDependentControls:disabled {
    background-color: #111314;
}

QWidget#overexposureDependentControls:disabled QLabel,
QWidget#overexposureDependentControls:disabled QCheckBox {
    color: #666D71;
}

QGroupBox {
    background-color: #121415;
    border: 1px solid #32373A;
    border-radius: 5px;
    margin-top: 15px;
    padding: 13px 8px 8px 8px;
    color: #DDE2E4;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 2px 8px;
    color: #E4E7E9;
    background-color: #0F1112;
    border: 1px solid #303538;
    border-radius: 3px;
    font-weight: 700;
}

QLabel {
    color: #CBD0D3;
}

/* ---------- Push buttons ---------- */
QPushButton {
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 0, y2: 1,
        stop: 0 #383D40,
        stop: 1 #2D3134
    );
    color: #D3D8DB;
    border: 1px solid #4B5256;
    border-radius: 4px;
    min-height: 24px;
    padding: 4px 10px;
}

QPushButton:hover {
    background-color: #373B3E;
    border-color: #684C35;
    color: #F1F4F5;
}

QPushButton:pressed,
QPushButton:checked {
    background-color: #413126;
    border-color: #76573A;
    color: #F7F9FA;
}

QPushButton:focus {
    border-color: #876342;
}

QPushButton:disabled {
    background-color: #2B2E31;
    color: #707679;
    border-color: #383D40;
}

/* Compact utility controls used throughout the Tools panel. */
QPushButton#resetBasicButton,
QPushButton#resetBaseTabButton,
QPushButton#resetCyanRedTabButton,
QPushButton#resetMagentaGreenTabButton,
QPushButton#resetYellowBlueTabButton,
QPushButton#resetHmsButton,
QPushButton#resetDetailButton,
QPushButton#selectCropButton,
QPushButton#applyCropButton,
QPushButton#cancelCropButton,
QPushButton#resizeButton {
    min-height: 18px;
    max-height: 18px;
    padding: 1px 8px;
    font-size: 9pt;
}

/* Compact Transform buttons use the same visual language as Reset controls. */
QToolButton#rotateLeftButton,
QToolButton#rotateRightButton,
QToolButton#flipHorizontalButton,
QToolButton#flipVerticalButton {
    min-width: 24px;
    max-width: 24px;
    min-height: 18px;
    max-height: 18px;
    padding: 1px 4px;
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 0, y2: 1,
        stop: 0 #383D40,
        stop: 1 #2D3134
    );
    color: #D3D8DB;
    border: 1px solid #4B5256;
    border-radius: 4px;
}

QToolButton#rotateLeftButton:hover,
QToolButton#rotateRightButton:hover,
QToolButton#flipHorizontalButton:hover,
QToolButton#flipVerticalButton:hover {
    background-color: #373B3E;
    border-color: #684C35;
    color: #F1F4F5;
}

QToolButton#rotateLeftButton:pressed,
QToolButton#rotateRightButton:pressed,
QToolButton#flipHorizontalButton:pressed,
QToolButton#flipVerticalButton:pressed {
    background-color: #413126;
    border-color: #76573A;
    color: #F7F9FA;
}

QToolButton#rotateLeftButton:disabled,
QToolButton#rotateRightButton:disabled,
QToolButton#flipHorizontalButton:disabled,
QToolButton#flipVerticalButton:disabled {
    background-color: #2B2E31;
    color: #707679;
    border-color: #383D40;
}

/* ---------- Sliders ---------- */
/*
    The slider widget itself is painted to match the surface beneath it.
    Only the thin dark-brown line and the small vertical handle remain visible.
*/
QSlider {
    border: none;
    padding: 0;
}

QDockWidget#toolsDock QSlider {
    background-color: #121415;
}

QDialog QSlider,
QMessageBox QSlider {
    background-color: #24282B;
}

QSlider:focus {
    border: none;
    outline: none;
}

QSlider::groove:horizontal {
    height: 2px;
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 0,
        stop: 0 #4A321F,
        stop: 0.45 #765638,
        stop: 0.72 #A58B69,
        stop: 1 #DDE2E4
    );
    border: none;
    border-radius: 1px;
}

QSlider::sub-page:horizontal,
QSlider::add-page:horizontal {
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 0,
        stop: 0 #4A321F,
        stop: 0.45 #765638,
        stop: 0.72 #A58B69,
        stop: 1 #DDE2E4
    );
    border: none;
    border-radius: 1px;
}

QSlider:hover::groove:horizontal,
QSlider:hover::sub-page:horizontal,
QSlider:hover::add-page:horizontal {
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 0,
        stop: 0 #5A3C24,
        stop: 0.45 #896541,
        stop: 0.72 #B9A07A,
        stop: 1 #F1F4F5
    );
}

QSlider::handle:horizontal {
    width: 6px;
    margin: -6px 0;
    background: qlineargradient(
        x1: 0, y1: 1,
        x2: 0, y2: 0,
        stop: 0 #65452B,
        stop: 1 #BFA77F
    );
    border: none;
    border-radius: 3px;
}

QSlider::handle:horizontal:hover {
    background: qlineargradient(
        x1: 0, y1: 1,
        x2: 0, y2: 0,
        stop: 0 #7B5531,
        stop: 1 #D6C29C
    );
}

QSlider::handle:horizontal:pressed {
    background: qlineargradient(
        x1: 0, y1: 1,
        x2: 0, y2: 0,
        stop: 0 #8C6037,
        stop: 1 #E2D1B1
    );
}

/* C++ sets this property on the matching text label during slider hover. */
QDockWidget#toolsDock QLabel[sliderHover="true"] {
    color: #C6A06D;
    font-weight: 600;
}

QSlider:disabled::groove:horizontal,
QSlider:disabled::sub-page:horizontal,
QSlider:disabled::add-page:horizontal {
    background-color: #2A2D2F;
}

QSlider:disabled::handle:horizontal {
    background-color: #3A3F42;
}

/* ---------- Spin boxes, fields, and combo boxes ---------- */
QSpinBox,
QDoubleSpinBox,
QLineEdit,
QComboBox {
    background-color: #0D0F10;
    color: #DDE2E4;
    border: 1px solid #41484C;
    border-radius: 3px;
    min-height: 22px;
    padding: 2px 5px;
    selection-background-color: #684C33;
    selection-color: #FFFFFF;
}

QSpinBox:focus,
QDoubleSpinBox:focus,
QLineEdit:focus,
QComboBox:focus {
    border-color: #7E5C3C;
    background-color: #202427;
}

QSpinBox:disabled,
QDoubleSpinBox:disabled,
QLineEdit:disabled,
QComboBox:disabled {
    background-color: #282B2E;
    color: #6E7478;
    border-color: #353A3D;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::down-button {
    width: 18px;
    background-color: #34393C;
    border-left: 1px solid #474E52;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    border-bottom: 1px solid #474E52;
}

QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: #3E3026;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    image: url(:/styles/spin-up.png);
    width: 9px;
    height: 6px;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    image: url(:/styles/spin-down.png);
    width: 9px;
    height: 6px;
}

QSpinBox::up-arrow:disabled,
QDoubleSpinBox::up-arrow:disabled,
QSpinBox::down-arrow:disabled,
QDoubleSpinBox::down-arrow:disabled {
    image: none;
}

QComboBox::drop-down {
    width: 22px;
    border-left: 1px solid #454C50;
}

QComboBox QAbstractItemView {
    background-color: #24282B;
    color: #DDE2E4;
    border: 1px solid #4A5155;
    selection-background-color: #382C23;
    selection-color: #FFFFFF;
}

/* ---------- Tabs ---------- */
QTabWidget::pane {
    background-color: #121415;
    border: 1px solid #41484C;
    border-radius: 3px;
    top: -1px;
}

QTabBar::tab {
    background-color: #24282B;
    color: #AAB0B4;
    border: 1px solid #3D4347;
    border-bottom: none;
    padding: 5px 7px;
    min-width: 38px;
}

QTabBar::tab:hover {
    background-color: #30363A;
    color: #E0E4E6;
}

QTabBar::tab:selected {
    background-color: #23211C;
    color: #F0F3F4;
    border-color: #66503B;
    border-bottom: 2px solid #76573A;
}

/* HMS is now a dedicated wide tool. Its active tab opens visually into
   the amber-outlined adjustment pane instead of looking like a button
   sitting above a separate box. */
QTabWidget#hmsTabWidget::pane {
    background-color: #121415;
    border: 1px solid #76573A;
    border-radius: 3px;
    top: -1px;
}

QTabWidget#hmsTabWidget QTabBar::tab {
    background-color: #24282B;
    color: #B8BEC1;
    border: 1px solid #3D4347;
    border-bottom: none;
    padding: 6px 14px;
    min-width: 92px;
}

QTabWidget#hmsTabWidget QTabBar::tab:hover {
    background-color: #30363A;
    color: #E0E4E6;
    border-color: #66503B;
}

QTabWidget#hmsTabWidget QTabBar::tab:selected {
    background-color: #121415;
    color: #F0F3F4;
    border: 1px solid #76573A;
    border-bottom-color: #121415;
    margin-bottom: -1px;
}

/* Visible HMS tab scrollers if the dock becomes unusually narrow. */
QTabBar QToolButton {
    background-color: #17191A;
    border: 1px solid #3C4144;
    border-radius: 3px;
    padding: 1px;
}

QTabBar QToolButton:hover {
    background-color: #302821;
    border-color: #684C35;
}

QTabBar QToolButton::left-arrow {
    image: url(:/styles/tab-left.png);
    width: 7px;
    height: 10px;
}

QTabBar QToolButton::right-arrow {
    image: url(:/styles/tab-right.png);
    width: 7px;
    height: 10px;
}

/* ---------- Check boxes and radio buttons ---------- */
QCheckBox,
QRadioButton {
    spacing: 7px;
    color: #CBD0D3;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 14px;
    height: 14px;
    background-color: #1A1D1F;
    border: 1px solid #50575B;
}

QCheckBox::indicator {
    border-radius: 3px;
}

QRadioButton::indicator {
    border-radius: 7px;
}

QCheckBox::indicator:checked,
QRadioButton::indicator:checked {
    background-color: #684C33;
    border-color: #9E774C;
}

/* ---------- Scroll bars ---------- */
QScrollBar:vertical {
    background-color: #1C1F21;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #4A5155;
    min-height: 34px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #5D4937;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
    height: 0;
}

QScrollBar:horizontal {
    background-color: #1C1F21;
    height: 12px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #4A5155;
    min-width: 34px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #5D4937;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
    width: 0;
}

/* ---------- Splitters, frames, and status ---------- */
QSplitter::handle {
    background-color: #383E42;
}

QSplitter::handle:hover {
    background-color: #684C32;
}

QFrame[frameShape="4"],
QFrame[frameShape="5"] {
    color: #42484C;
}

QStatusBar {
    background-color: #191C1E;
    color: #AAB0B4;
    border-top: 1px solid #3C4246;
}

QStatusBar::item {
    border: none;
}

QToolTip {
    background-color: #16191B;
    color: #E5E9EB;
    border: 1px solid #596268;
    padding: 4px 6px;
}
